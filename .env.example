# Copy to .env and fill from `pnpm supabase status -o env` (see docs/runbooks/local-database.md).
# Never put a production value in a local file.

# The local Supabase API. The port comes from supabase/config.toml.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# PUBLISHABLE_KEY from `supabase status -o env`. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET_KEY from `supabase status -o env`. Bypasses RLS: server code and tests only.
SUPABASE_SECRET_KEY=
